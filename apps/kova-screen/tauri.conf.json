{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kova Screen",
  "version": "0.1.1",
  "identifier": "me.kova.screen",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Kova Contributors",
    "homepage": "https://github.com/cubiix3/Kova-Screen",
    "copyright": "Copyright (c) 2026 Kova Contributors",
    "category": "Utility",
    "shortDescription": "Fast screenshots, GIFs and MP4 recording for Windows.",
    "longDescription": "Kova Screen is a fast, minimal capture tool for Windows: region, window and fullscreen screenshots, MP4 and GIF recording, clipboard integration and optional vgy.me upload.",
    "licenseFile": "../../LICENSE-MIT",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "German"]
      }
    }
  }
}
